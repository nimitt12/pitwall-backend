NODE_ENV=development
PORT=8080
# Generate a new secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-before-deploying
JWT_TTL_SECONDS=3600
GOOGLE_CLIENT_ID=
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_DATABASE=pitwall
PG_PORT=5432
PG_POOL_MAX=10
# Verified TLS is the default. Supabase's public CA is bundled for Supabase hosts.
# PG_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
# PG_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Only for a local development PostgreSQL server without TLS:
# PG_SSL=false

# Exact comma-separated HTTP or HTTPS browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional shared rate-limit storage. Enable it for multi-instance deployments.
REDIS_ENABLED=false
# Required when REDIS_ENABLED=true. Use authenticated Redis on a private network, preferably rediss://.
# REDIS_URL=rediss://username:password@redis.example.com:6379
# Leave unset for direct access. Set ONLY the actual reverse proxy IPs/CIDRs.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Per-client budgets, aggregated across all routes in each group:
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_EXPENSIVE=10
# Shared service-wide auth budget per minute:
RATE_LIMIT_AUTH_GLOBAL=100
HTTP_MAX_INFLIGHT=200
SSE_MAX_CONNECTIONS=200
SSE_MAX_PER_IP=3

# Optional if the F1 timing feed requires a subscription token:
# F1_LIVETIMING_TOKEN=
